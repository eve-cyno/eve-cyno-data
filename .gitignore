# Data (the SDE is built locally by `go run ./cmd/sde`, never committed)
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
# The published intel baseline fixture is a committed byte copy (hash-pinned in intelbase tests)
!intelbase/testdata/golden-v1.sqlite
*.db

# Binaries (build into bin/; the module root holds the dataapi/ and sde/ packages,
# so never ignore those names at the root)
*.exe
*.test
*.out
/bin/
/dist/

# Local environment and editors
.env
.env.*
!.env.example
.idea/
.vscode/
*.log

# The Python examples resolve their dependencies on `uv run`; a lock would only pin stale versions.
examples/python/uv.lock
