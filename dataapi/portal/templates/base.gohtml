{{define "topbar-portal"}}<!-- ============ TOP BAR (shared partial) ============ -->
<header class="topbar">
  <div class="topbar-in">
    <button class="icon-btn topbar-menu" type="button" data-drawer-open aria-label="Open menu" aria-expanded="false"><svg class="ico" aria-hidden="true"><use href="#i-menu"/></svg></button>
    <!-- LOCKUP: one self-contained element (brand/lockup-data.svg). To change the brand, swap the <img> src; nothing else depends on it. -->
    <a class="lockup" href="/" aria-label="EVE-CYNO DATA home"><img class="lockup-img" src="{{.Assets}}/lockup-data.svg" alt="EVE-CYNO DATA" width="269" height="32"></a>
    <nav class="topnav" data-drawer aria-label="Main">
      <div class="topnav-head">
        <a class="lockup" href="/" aria-label="EVE-CYNO DATA home"><img class="lockup-img" src="{{.Assets}}/lockup-data.svg" alt="EVE-CYNO DATA" width="269" height="32"></a>
        <button class="icon-btn" type="button" data-drawer-close aria-label="Close menu"><svg class="ico" aria-hidden="true"><use href="#i-close"/></svg></button>
      </div>
      <a href="/docs/">Docs</a>
      <a href="/docs/claude-code">Claude Code</a>
      <a href="/docs/tools">Tools</a>
      <a href="#credits">Hall of Fame</a>
    </nav>
    <div class="topbar-actions">
      <div class="search" data-search>
        <div class="search-field">
          <svg class="ico" aria-hidden="true"><use href="#i-search"/></svg>
          <input class="search-input" type="search" placeholder="Search tools and docs" aria-label="Search tools and docs" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-autocomplete="list" data-search-input>
          <kbd class="kbd" aria-hidden="true">/</kbd>
          <button class="search-close" type="button" data-search-close aria-label="Close search"><svg class="ico" aria-hidden="true"><use href="#i-close"/></svg></button>
        </div>
        <div class="search-results" role="listbox" aria-label="Search results" data-search-results hidden></div>
      </div>
      <button class="icon-btn search-toggle" type="button" data-search-toggle aria-label="Search"><svg class="ico" aria-hidden="true"><use href="#i-search"/></svg></button>
      <a class="btn-ghost topbar-discord" href="https://discord.gg/XZzkH38dt9" aria-label="EVE-Cyno Discord"><svg class="ico" aria-hidden="true"><use href="#i-discord"/></svg><span class="label">Discord</span></a>
    </div>
  </div>
</header>
<div class="scrim" data-drawer-scrim></div>
{{end}}

{{define "topbar-docs"}}<!-- ============ TOP BAR (shared partial) ============ -->
<header class="topbar">
  <div class="topbar-in">
    <button class="icon-btn topbar-menu" type="button" data-drawer-open aria-label="Open documentation menu" aria-expanded="false"><svg class="ico" aria-hidden="true"><use href="#i-menu"/></svg></button>
    <!-- LOCKUP: one self-contained element (brand/lockup-data.svg). To change the brand, swap the <img> src; nothing else depends on it. -->
    <a class="lockup" href="/" aria-label="EVE-CYNO DATA home"><img class="lockup-img" src="{{.Assets}}/lockup-data.svg" alt="EVE-CYNO DATA" width="269" height="32"></a>
    <nav class="topnav" aria-label="Main">
      <a href="/docs/" aria-current="page">Docs</a>
      <a href="/docs/tools">Tools</a>
      <a href="/#credits">Hall of Fame</a>
    </nav>
    <div class="topbar-actions">
      <div class="search" data-search>
        <div class="search-field">
          <svg class="ico" aria-hidden="true"><use href="#i-search"/></svg>
          <input class="search-input" type="search" placeholder="Search tools and docs" aria-label="Search tools and docs" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="false" aria-autocomplete="list" data-search-input>
          <kbd class="kbd" aria-hidden="true">/</kbd>
          <button class="search-close" type="button" data-search-close aria-label="Close search"><svg class="ico" aria-hidden="true"><use href="#i-close"/></svg></button>
        </div>
        <div class="search-results" role="listbox" aria-label="Search results" data-search-results hidden></div>
      </div>
      <button class="icon-btn search-toggle" type="button" data-search-toggle aria-label="Search"><svg class="ico" aria-hidden="true"><use href="#i-search"/></svg></button>
      <a class="btn-ghost topbar-discord" href="https://discord.gg/XZzkH38dt9" aria-label="EVE-Cyno Discord"><svg class="ico" aria-hidden="true"><use href="#i-discord"/></svg><span class="label">Discord</span></a>
    </div>
  </div>
</header>
<div class="scrim" data-drawer-scrim></div>
{{end}}

{{define "discord-band"}}<!-- ============ DISCORD (main channel) ============ -->
<section class="discord-band" aria-label="Community">
  <div class="wrap discord-in">
    <span class="glyph" aria-hidden="true"><svg class="ico"><use href="#i-discord"/></svg></span>
    <div>
      <h2>Discord is where EVE-Cyno lives.</h2>
      <p>Questions, bugs, the harness you want next, or a change to the Hall of Fame: ask in the EVE-Cyno Discord.</p>
    </div>
    <a class="btn primary" href="https://discord.gg/XZzkH38dt9"><svg class="ico" aria-hidden="true"><use href="#i-discord"/></svg>Join the Discord</a>
  </div>
</section>
{{end}}

{{define "footer"}}<!-- ============ FOOTER (shared partial) ============ -->
<footer class="site-foot">
  <div class="wrap">
    <div class="f-grid">
      <div>
        <a class="lockup" href="/" aria-label="EVE-CYNO DATA home"><img class="lockup-img" src="{{.Assets}}/lockup-data.svg" alt="EVE-CYNO DATA" width="269" height="32"></a>
        <p>Deterministic EVE Online data for tools and AI agents. Hobby-run by Bythlak. Not an official EVE Online or Fenris Creations service.</p>
      </div>
      <div><h4>Docs</h4><ul><li><a href="/docs/">Getting started</a></li><li><a href="/docs/claude-code">Claude Code plugin</a></li><li><a href="/docs/mcp">MCP</a></li><li><a href="/docs/rest">REST &amp; OpenAPI</a></li><li><a href="/docs/tools">Tools reference</a></li></ul></div>
      <div><h4>Machine-readable</h4><ul><li><a href="{{.URL}}/llms.txt">llms.txt</a></li><li><a href="{{.URL}}/llms-full.txt">llms-full.txt</a></li><li><a href="{{.URL}}{{.Prefix}}/openapi.yaml">OpenAPI (YAML)</a></li><li><a href="{{.URL}}{{.Prefix}}/openapi.json">OpenAPI (JSON)</a></li><li><a href="https://github.com/eve-cyno/eve-cyno-data">Source code (MIT)</a></li></ul></div>
      <div><h4>Service</h4><ul><li><a href="https://discord.gg/XZzkH38dt9">Discord</a></li><li><a href="{{.URL}}/terms">Terms</a></li><li><a href="/#credits">Hall of Fame</a></li><li><a href="{{.URL}}{{.Prefix}}/health">Status</a></li><li><a href="https://eve-cyno.dev">eve-cyno.dev</a></li></ul></div>
    </div>
    <p class="dla">© 2014 Fenris Creations hf. All rights reserved. 'EVE', 'EVE Online', 'Fenris Creations', and all related logos and images are trademarks or registered trademarks of Fenris Creations hf. This material is used with limited permission of Fenris Creations. No official affiliation or endorsement by Fenris Creations is stated or implied. Created under the EVE Developer License Agreement.</p>
    <p class="dla">Non-commercial. Some reference text is from the <a href="https://wiki.eveuniversity.org/">EVE University Wiki</a>, licensed <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Community fits belong to their authors and sites.</p>
  </div>
</footer>
{{end}}

{{define "search-index"}}<script type="application/json" data-search-index>
{{.SearchIndex}}
</script>
<script src="{{.Assets}}/site.js" defer></script>{{end}}
