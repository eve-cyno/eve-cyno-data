     "b1": {"dps": 200, "ehp": 0, "capStable": true}, "b2": {"dps": 100, "ehp": 0, "capStable": true},
     "cand": {"dps": 99, "ehp": 0, "valid": true, "capStable": true},
     "expect": {"accepted": true, "gatesMet": true, "objective": 0.99}},
    {"name": "both baselines 0: objective 1, every gate met", "kind": "refit",
     "policy": {"gates": [{"stat": "dps", "atLeast": 100}, {"stat": "ehp", "atLeast": 100}], "baseline": "flown", "allowT2toT1": true, "allowRigChanges": false, "from": "request"},
     "b1": {"dps": 0, "ehp": 0, "capStable": true}, "b2": {"dps": 0, "ehp": 0, "capStable": true},
     "cand": {"dps": 0, "ehp": 0, "valid": true, "capStable": true},
     "expect": {"accepted": true, "gatesMet": true, "objective": 1}},
    {"name": "an improvement ranks above 1", "kind": "refit",
     "policy": {"gates": [{"stat": "dps", "atLeast": 100}], "baseline": "flown", "allowT2toT1": true, "allowRigChanges": false, "from": "request"},
     "b1": {"dps": 200, "ehp": 2000, "capStable": true}, "b2": {"dps": 100, "ehp": 1000, "capStable": true},
