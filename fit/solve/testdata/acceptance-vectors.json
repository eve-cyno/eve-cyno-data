{
  "version": 1,
  "note": "Language-neutral vectors of the acceptance rule (spec 13.2). The Go test fit/solve TestAccept_Vectors and the plugin's acceptance.test read the same bytes. Numbers compare after rounding to 10 significant digits (1e-9 relative). Percent texts use U+2212 for the minus sign.",
  "fallback": [
    {"kind": "refit", "policy": {"gates": [{"stat": "dps", "atLeast": 98}, {"stat": "ehp", "atLeast": 98}], "baseline": "flown", "allowT2toT1": true, "allowRigChanges": false, "from": "fallback"}},
    {"kind": "downgrade", "policy": {"gates": [], "baseline": "flown", "allowT2toT1": true, "allowRigChanges": false, "from": "fallback"}},
    {"kind": "convert", "policy": {"gates": [], "baseline": "flown", "allowT2toT1": true, "allowRigChanges": false, "from": "fallback"}}
