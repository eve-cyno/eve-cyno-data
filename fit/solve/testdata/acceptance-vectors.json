  "accept": [
    {"name": "fix fallback: exactly 98 % passes", "kind": "refit",
     "policy": {"gates": [{"stat": "dps", "atLeast": 98}, {"stat": "ehp", "atLeast": 98}], "baseline": "flown", "allowT2toT1": true, "allowRigChanges": false, "from": "fallback"},
     "b1": {"dps": 200, "ehp": 2000, "capStable": true}, "b2": {"dps": 100, "ehp": 1000, "capStable": true},
