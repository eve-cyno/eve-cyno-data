     "b1": {"dps": 200, "ehp": 2000, "capStable": true}, "b2": {"dps": 100, "ehp": 1000, "capStable": true},
     "cand": {"dps": 100, "ehp": 1000, "valid": true, "capStable": true},
     "expect": {"accepted": true, "gatesMet": true, "objective": 1}},
    {"name": "fix at 100 %: one unit less fails", "kind": "refit",
