     "b1": {"dps": 200, "ehp": 2000, "capStable": true}, "b2": {"dps": 100, "ehp": 1000, "capStable": true},
     "cand": {"dps": 100, "ehp": 1000, "valid": true, "capStable": false},
     "expect": {"accepted": false, "gatesMet": true, "objective": 1}},
    {"name": "capacitor unstable in B2, stable in the candidate: accepted", "kind": "refit",
